@using TicketingCRM.ViewModels
@inject TicketingCRM.Domain.Configuration.Interfaces.IServerSettingsService Service
@if (Model.Loading) { <p class="loading-state" role="status">Loading system settings…</p> }
else if (Model.Settings is null)
{
    @if (Model.Error is not null) { <p class="feedback" role="alert">@Model.Error</p> }
    <section class="panel workspace-form page-enter"><h2>Workspace preferences</h2><p>Use Appearance to select your theme. System configuration is restricted to platform administrators.</p><a class="button secondary" href="/account/settings">Account settings</a></section>
}
else
{
    @if (Model.Message is not null) { <p class="feedback" role="status">@Model.Message</p> }
    @if (Model.Error is not null) { <p class="feedback" role="alert">@Model.Error</p> }
    <nav class="workflow-tabs page-enter" aria-label="System settings sections">@foreach(var tab in Sections){<a href="@($"/settings/{tab.Key}")" aria-current="@(Active == tab.Key ? "page" : null)">@tab.Value</a>}</nav>
    <div class="workflow-stack page-enter">
        @if(Active == "general"){<SystemGeneralSettings Model="Model" OnSaveAddress="Model.SavePublicAddress" OnSaveOrganization="Model.SaveOrganization" />}
        @if(Active == "email"){<SystemEmailSettings Model="Model" OnSave="Model.SaveEmail" OnTest="Model.TestEmail" />}
        @if(Active == "database"){<section class="panel workspace-form database-settings">
            <h2>Database connection</h2><p>App Souls builds the connection string from these fields. Test the server and catalog before switching. Pending migrations for this installation run automatically on startup; first-time activation stays in guided setup.</p>
            <DatabaseMaintenanceForm CurrentProvider="@Model.Settings.DatabaseProvider" CurrentFields="Model.Settings.Database" />
        </section>}
        @if(Active == "scanner"){<SystemScannerSettings Model="Model" OnCheck="Model.CheckScanner" />}
        @if(Active == "integrations"){<SystemIntegrationSettings Model="Model" OnSave="Model.SaveIntegration" />}
    </div>
}
@code {
 [Parameter] public string Section {get;set;} = "general";
 private string Active => Sections.ContainsKey(Section) ? Section : "general";
 private static readonly IReadOnlyDictionary<string,string> Sections = new Dictionary<string,string> { ["general"]="Organization", ["email"]="Email", ["database"]="Database", ["scanner"]="Malware scanning", ["integrations"]="Integrations" };
 private ServerSettingsViewModel Model = null!;
 protected override async Task OnInitializedAsync() { Model = new(Service); await Model.InitializeAsync(); }
}
