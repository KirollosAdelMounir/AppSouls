@typeparam TItem
<div class="table-scroll"><table class="data-table"><thead><tr>@Headings</tr></thead><tbody>@foreach(var item in Items){<tr @key="item">@Row(item)</tr>}</tbody></table></div>
@if(Items.Count==0){<p>@EmptyMessage</p>}
@code {
 [Parameter]public IReadOnlyList<TItem> Items{get;set;}=[];
 [Parameter]public RenderFragment? Headings{get;set;}
 [Parameter]public RenderFragment<TItem> Row{get;set;}=default!;
 [Parameter]public string EmptyMessage{get;set;}="No records yet.";
}
