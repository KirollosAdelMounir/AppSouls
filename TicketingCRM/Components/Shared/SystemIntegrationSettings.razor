@using TicketingCRM.ViewModels
<section class="panel workspace-form integration-settings"><h2>Integration credentials</h2><p>Store the credentials needed for external services. Saving configuration does not enable an integration or make a network request.</p><div class="table-scroll"><table class="data-table"><thead><tr><th>Integration</th><th>Base URL</th><th>Configured credentials</th></tr></thead><tbody>@foreach(var item in Model.Settings!.Integrations){<tr @key="item.Name"><td>@item.Name</td><td>@item.BaseUrl</td><td>@string.Join(", ",item.ConfiguredCredentialNames)</td></tr>}</tbody></table></div><form @onsubmit="OnSave" @onsubmit:preventDefault><fieldset class="form-fields" disabled="@(!RendererInfo.IsInteractive || Model.Busy)"><div class="control-grid"><div class="soul-field"><label for="integration-name">Integration identifier</label><input id="integration-name" class="soul-input" @bind="Model.IntegrationName" required maxlength="64" /></div><div class="soul-field"><label for="integration-url">HTTPS base URL (optional)</label><input id="integration-url" class="soul-input" @bind="Model.IntegrationUrl" type="url" /></div><div class="soul-field"><label for="credential-name">Credential name</label><input id="credential-name" class="soul-input" @bind="Model.CredentialName" maxlength="64" placeholder="For example: ApiKey" /></div><div class="soul-field"><label for="credential-value">New credential value</label><input id="credential-value" class="soul-input" @bind="Model.CredentialValue" type="password" maxlength="8192" autocomplete="new-password" /></div></div><button class="button primary" type="submit" disabled="@Model.Busy">Save integration</button></fieldset></form></section>
@code {
 [Parameter, EditorRequired] public ServerSettingsViewModel Model { get; set; } = default!;
 [Parameter] public EventCallback OnSave { get; set; }
}
