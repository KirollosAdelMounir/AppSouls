@implements IAsyncDisposable
@inject IJSRuntime JS
<form @ref="Form" method="post" action="/account/activate" data-enhance="false"><AntiforgeryToken /><input type="hidden" name="InvitationId" value="@InvitationId" /><input type="hidden" name="Token" value="" />
<div class="soul-field"><label for="activation-password">New password</label><input id="activation-password" class="soul-input" name="Password" type="password" required minlength="8" maxlength="1024" autocomplete="new-password" /></div><div class="soul-field"><label for="activation-confirm">Confirm password</label><input id="activation-confirm" class="soul-input" name="ConfirmPassword" type="password" required minlength="8" maxlength="1024" autocomplete="new-password" /></div><button class="button primary" type="submit" disabled="@(!Ready)">Activate account</button></form>
@code {
 [Parameter]public Guid InvitationId{get;set;}
 private ElementReference Form;private InvitationFormInterop? Interop;private bool Ready;
 protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender){Interop=new(JS);Ready=await Interop.InitializeAsync(Form);StateHasChanged();}}
 public async ValueTask DisposeAsync(){if(Interop is not null)await Interop.DisposeAsync();}
}
