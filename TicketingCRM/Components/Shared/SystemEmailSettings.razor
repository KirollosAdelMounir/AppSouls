@using TicketingCRM.ViewModels
<section class="panel workspace-form"><h2>Email delivery</h2><p>Configure your SMTP provider. TLS is required. Credentials are encrypted in the server vault.</p><form @onsubmit="OnSave" @onsubmit:preventDefault><fieldset class="form-fields" disabled="@(!RendererInfo.IsInteractive || Model.Busy)"><label class="check-field"><input type="checkbox" @bind="Model.EmailEnabled" /> Enable email delivery</label><div class="soul-field"><label for="smtp-host">SMTP host</label><input id="smtp-host" class="soul-input" @bind="Model.Host" maxlength="253" /></div><div class="soul-field"><label for="smtp-port">Port</label><input id="smtp-port" class="soul-input" type="number" @bind="Model.Port" min="1" max="65535" /></div><div class="soul-field"><label for="sender">Sender address</label><input id="sender" class="soul-input" type="email" @bind="Model.Sender" maxlength="254" /></div><div class="soul-field"><label for="smtp-user">SMTP username</label><input id="smtp-user" class="soul-input" @bind="Model.UserName" maxlength="320" autocomplete="off" /></div><div class="soul-field"><label for="smtp-password">New SMTP password</label><input id="smtp-password" class="soul-input" type="password" @bind="Model.Password" maxlength="8192" autocomplete="new-password" placeholder="@(Model.Settings!.SmtpPasswordConfigured?"Configured — leave empty to preserve":"Not configured")" /></div><div class="settings-actions"><button class="button secondary" type="button" @onclick="OnTest">Test email connection</button><button class="button primary" type="submit">Save email settings</button></div><small>Checks TLS and SMTP authentication without sending email. A blank password is reused only for the same host, port and username.</small></fieldset></form></section>
@code {
 [Parameter, EditorRequired] public ServerSettingsViewModel Model { get; set; } = default!;
 [Parameter] public EventCallback OnSave { get; set; }
 [Parameter] public EventCallback OnTest { get; set; }
}
