@page "/support/{TicketId:guid}"
@page "/support/{TicketId:guid}/{Section}"
@attribute [Authorize]
@inject NavigationManager Navigation
<PageTitle>Support ticket | App Souls</PageTitle>
<div class="page-heading page-enter"><div><p class="eyebrow">SUPPORT · TICKETING</p><h1>@Title</h1><p>One inquiry, with its replies, attachments and progress in focused views.</p></div><a class="button secondary" href="/support/tickets">All tickets</a></div>
<SupportTicketWorkspace TicketId="TicketId" Mode="@Mode" ReplyId="ReplyId" @key="Navigation.Uri" @rendermode="InteractiveServer" />
@code{[Parameter]public Guid TicketId{get;set;}[Parameter]public string? Section{get;set;}[SupplyParameterFromQuery]public Guid? ReplyId{get;set;}private string Mode=>Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/').Split('/').Last() switch{"replies"=>"replies","attachments"=>"attachments","progress"=>"progress",_=>"details"};private string Title=>Mode switch{"replies"=>"Ticket replies","attachments"=>"Ticket attachments","progress"=>"Ticket progress",_=>"Ticket inquiry"};}
