@page "/license-models"
@page "/license-models/new"
@inject NavigationManager Navigation
@attribute [Authorize(Policy="DeveloperWorkspace")]
<PageTitle>License models | App Souls</PageTitle>
<div class="page-heading"><div><p class="eyebrow">LICENSING</p><h1>License model builder</h1><p>Define typed attributes and map them to each customer's subscribed product.</p></div><a class="button secondary" href="/licenses">Issued licenses</a></div>
<nav class="workflow-tabs page-enter" aria-label="License model views"><NavLink href="/license-models" Match="NavLinkMatch.All">Published models</NavLink><NavLink href="/license-models/new">Build a model</NavLink></nav>
<LicenseModelBuilder Mode="@Mode" @key="Mode" @rendermode="InteractiveServer" />
@code{private string Mode=>Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/').EndsWith("/new")?"new":"list";}
