@page "/account/security"
@layout SettingsLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject TicketingCRM.Domain.Accounts.Interfaces.IAccountSettingsService Accounts

<PageTitle>Account security | App Souls</PageTitle>
<nav class="workflow-tabs page-enter" aria-label="Account settings"><a href="/account/settings">Profile</a><a href="/account/settings/password">Password</a><a href="/account/security" aria-current="page">Security</a></nav>
<section class="panel account-panel page-enter">
    <p class="eyebrow">YOUR ACCOUNT</p><h1>Two-step verification</h1>
    @if (Enabled)
    {
        <p>Your authenticator is enabled. Sign-in requires your password and a current authenticator code.</p>
        <h2>Replace recovery codes</h2><p>Generate a fresh set if your saved codes may have been exposed. This invalidates all previous recovery codes.</p>
        <form method="post" action="/account/mfa/recovery-codes" data-enhance="false">
            <AntiforgeryToken />
            <div class="soul-field"><label for="password">Current password</label><input id="password" class="soul-input" type="password" name="Password" required maxlength="1024" autocomplete="current-password" /></div>
            <div class="soul-field"><label for="code">Authenticator code</label><input id="code" class="soul-input" name="Code" required maxlength="12" inputmode="numeric" autocomplete="one-time-code" /></div>
            <button class="button primary" type="submit">Generate recovery codes</button>
        </form>
    }
    else
    {
        <p>Two-step verification is optional. You can keep using your email and password. If you choose to enable it, protect your workspace with a time-based authenticator app. You will receive recovery codes after confirming your first code.</p>
        <form method="post" action="/account/mfa/begin" data-enhance="false">
            <AntiforgeryToken />
            <div class="soul-field"><label for="password">Current password</label><input id="password" class="soul-input" type="password" name="Password" required maxlength="1024" autocomplete="current-password" /></div>
            <button class="button primary" type="submit">Set up authenticator</button>
        </form>
    }
    <p><a href="/">Return to workspace</a></p>
</section>
@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    private bool Enabled;
    protected override async Task OnInitializedAsync()
    {
        HttpContext.Response.Headers.CacheControl = "no-store, private";
        Enabled = (await Accounts.GetAsync()).TwoFactorEnabled;
    }
}
