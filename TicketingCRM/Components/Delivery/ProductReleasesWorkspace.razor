@inject IJSRuntime JS
@using TicketingCRM.ViewModels
@inject TicketingCRM.Domain.Delivery.Interfaces.IProductReleaseService Releases
@inject TicketingCRM.Domain.Workspace.Interfaces.IWorkspaceService Workspace
<OperationFeedback Busy="Model.Busy" Message="@Model.Message" Error="Model.HasError" />
@if(Model.Data is {} data){
@if(Mode == "upload" && data.CanManage){<section class="panel workspace-form"><h2>Upload an installation</h2><p>Files are streamed with progress and cancellation. Files beyond the local scanner’s supported inspection size remain quarantined. Uploads remain quarantined until a local malware scan succeeds. Published versions are immutable; use a new version for changes.</p><div class="form-grid"><SoulDropdown Label="Product" Options="Model.Products" @bind-Value="Model.Product" /><div class="soul-field"><label for="release-version">Version</label><input id="release-version" class="soul-input" @bind="Model.Version" @bind:event="oninput" maxlength="80" placeholder="1.0.0" /></div><SoulDropdown Label="Platform" Options="ProductReleasesViewModel.Platforms" @bind-Value="Model.Platform" /><div class="soul-field"><label for="release-notes">Release notes</label><textarea id="release-notes" class="soul-input" @bind="Model.Notes" @bind:event="oninput" maxlength="8000"></textarea></div><div class="soul-field"><label for="release-file">Installation package (up to 8 GiB)</label><InputFile @key="FileInputVersion" id="release-file" OnChange="ChooseFile" disabled="@(Model.Busy||Transferring)" accept=".zip,.msi,.exe,.deb,.rpm,.pkg,.gz,.sh,.dmg,.apk,.aab" /></div></div><p>@Filename</p><button id="release-upload" class="button primary" @onclick="Upload" disabled="@(Model.Busy||Transferring||File is null)">Upload to quarantine</button></section>}
@if(Mode == "upload" && data.CanManage){<section class="panel workspace-form page-enter"><h2>Publish a mobile store release</h2><p>Use the product, version and mobile platform above, then enter the official store product URL. Store listings link to the external store; they do not publish an uploaded binary.</p><div class="soul-field"><label for="release-store-url">Play Store or App Store URL</label><input id="release-store-url" class="soul-input" type="url" @bind="Model.StoreUrl" maxlength="2048" /></div><button class="button secondary" disabled="@(Model.Busy || !RendererInfo.IsInteractive)" @onclick="Model.SaveStoreAsync">Publish store link</button></section>}
@if(Mode != "upload" && (Mode == "published" || data.CanManage)){<section class="panel workspace-form page-enter"><h2>@(Mode == "unpublished" ? "Unpublished installations" : "Published releases")</h2>@if(data.Releases.Count==0){<p>No installation packages are available for your current subscriptions.</p>}<ul class="license-field-list">@foreach(var release in data.Releases.Where(r => Mode == "unpublished" ? r.Status != "Published" : r.Status == "Published")){<li @key="release.Id"><div><strong>@release.ProductName · @release.Version · @release.Platform</strong><p>@release.Notes</p><small>@release.Status @if(release.StoreUrl is null){<span>· @release.Size bytes · SHA-256: @release.Sha256</span>}</small></div><div class="release-actions">@if(release.Status=="Published" && release.StoreUrl is not null){<a class="button primary" href="@release.StoreUrl" target="_blank" rel="noopener noreferrer">@(release.Platform == "Android" ? "Open Play Store" : "Open App Store")<span class="sr-only"> (new tab)</span></a>}@if(release.Status=="Published" && release.StoreUrl is null){<a class="button primary" data-enhance-nav="false" data-transfer-download data-transfer-filename="@release.Filename" href="@($"/api/product-releases/{release.Id}/download")">Download installation</a><a class="button secondary" data-transfer-download data-transfer-filename="@($"release-{release.Id:N}-manifest.json")" href="@($"/api/product-releases/{release.Id}/manifest")">Signed manifest</a>}@if(data.CanManage){@if(release.Status=="Quarantined"){<button class="button primary" disabled="@Model.Busy" @onclick="()=>Model.PublishAsync(release.Id)">Scan &amp; publish</button>}@if(release.Status!="Revoked"){<button class="button secondary" disabled="@Model.Busy" @onclick="()=>Model.RevokeAsync(release.Id)">Revoke</button>}}</div></li>}</ul><div class="form-actions"><button class="button secondary" disabled="@(Model.Busy||Model.Page==1)" @onclick="()=>Model.ChangePageAsync(Model.Page-1)">Previous page</button><span>Page @Model.Page</span><button class="button secondary" disabled="@(Model.Busy||data.Releases.Count<100)" @onclick="()=>Model.ChangePageAsync(Model.Page+1)">Next page</button></div></section>}
@if(Mode == "upload" && !data.CanManage || Mode == "unpublished" && !data.CanManage){<p role="alert">Installation management is restricted to technical developers.</p>}
}
@code {
 [Parameter] public string Mode { get; set; } = "published";
 private ProductReleasesViewModel Model=null!;private IBrowserFile? File;private string Filename=>File?.Name??"No file selected.";
 protected override async Task OnInitializedAsync(){Model=new(Releases,Workspace){View=Mode=="upload"?"unpublished":Mode};await Model.LoadAsync();}
 private void ChooseFile(InputFileChangeEventArgs e)=>File=e.File;
 private CancellationTokenSource? UploadCancellation;
 private bool Transferring;
 private int FileInputVersion;
 [JSInvokable] public void CancelUpload()=>UploadCancellation?.Cancel();
 private async Task Upload()
 {
  if(File is null||Transferring)return;
  Transferring=true;var file=File;string? id=null;IJSObjectReference? transfers=null;
  using var cancellation=new CancellationTokenSource();UploadCancellation=cancellation;
  using var reference=DotNetObjectReference.Create(this);
  var clock=System.Diagnostics.Stopwatch.StartNew();var last=TimeSpan.Zero;
  try
  {
   transfers=await JS.InvokeAsync<IJSObjectReference>("import","./"+Assets["transfer-progress.js"]);
   id=await JS.InvokeAsync<string>("appSoulsTransfers.begin","Upload",file.Name,file.Size,"release-upload");
   await JS.InvokeVoidAsync("appSoulsTransfers.bindCancellation",id,reference);
   await using var stream=new TicketingCRM.Core.FileProcessing.TransferReadStream(()=>file.OpenReadStream(8L*1024*1024*1024,cancellation.Token),async (bytes,ct)=>
   {
    if(clock.Elapsed-last<TimeSpan.FromMilliseconds(250)&&bytes!=file.Size)return;
    last=clock.Elapsed;
    await JS.InvokeVoidAsync("appSoulsTransfers.update",ct,id,bytes,bytes==file.Size?"Upload received — validating and saving":"Uploading");
   });
   await Model.UploadAsync(file.Name,stream,cancellation.Token);
   await JS.InvokeVoidAsync("appSoulsTransfers.finish",id,!Model.HasError,cancellation.IsCancellationRequested&&Model.HasError?"Upload cancelled. Check the release list before retrying.":Model.Message);
   if(!Model.HasError){File=null;FileInputVersion++;}
  }
  catch(Exception error)when(error is IOException or JSException or InvalidOperationException or OperationCanceledException)
  {
   Model.UploadInterrupted();
   if(id is not null)try{await JS.InvokeVoidAsync("appSoulsTransfers.finish",id,false,Model.Message);}catch(JSDisconnectedException){}
  }
  finally
  {
   UploadCancellation=null;Transferring=false;
   if(transfers is not null)try{await transfers.DisposeAsync();}catch(JSDisconnectedException){}
  }
 }
}
