@using TicketingCRM.ViewModels
@inject TicketingCRM.Domain.Delivery.Interfaces.IProductReleaseService Releases
@inject TicketingCRM.Domain.Workspace.Interfaces.IWorkspaceService Workspace
<OperationFeedback Busy="Model.Busy" Message="@Model.Message" Error="Model.HasError" />
@if(Model.Data is {} data){
@if(data.CanManage){<section class="panel workspace-form"><h2>Upload an installation</h2><p>Uploads remain quarantined until a local malware scan succeeds. Published versions are immutable; use a new version for changes.</p><div class="form-grid"><SoulDropdown Label="Product" Options="Model.Products" @bind-Value="Model.Product" /><div class="soul-field"><label for="release-version">Version</label><input id="release-version" class="soul-input" @bind="Model.Version" maxlength="80" placeholder="1.0.0" /></div><SoulDropdown Label="Platform" Options="ProductReleasesViewModel.Platforms" @bind-Value="Model.Platform" /><div class="soul-field"><label for="release-notes">Release notes</label><textarea id="release-notes" class="soul-input" @bind="Model.Notes" maxlength="8000"></textarea></div><div class="soul-field"><label for="release-file">Installation package (up to 512 MB)</label><InputFile id="release-file" OnChange="ChooseFile" disabled="@Model.Busy" accept=".zip,.msi,.exe,.deb,.rpm,.pkg,.gz" /></div></div><p>@Filename</p><button class="button primary" @onclick="Upload" disabled="@(Model.Busy||File is null)">Upload to quarantine</button></section>}
<section class="panel workspace-form"><h2>@(data.CanManage?"Product releases":"Your software downloads")</h2>@if(data.Releases.Count==0){<p>No installation packages are available for your current subscriptions.</p>}<ul class="license-field-list">@foreach(var release in data.Releases){<li @key="release.Id"><div><strong>@release.ProductName · @release.Version · @release.Platform</strong><p>@release.Notes</p><small>@release.Status · @release.Size bytes · SHA-256: @release.Sha256</small></div><div class="release-actions">@if(release.Status=="Published"){<a class="button primary" data-enhance-nav="false" href="@($"/api/product-releases/{release.Id}/download")">Download installation</a><a class="button secondary" href="@($"/api/product-releases/{release.Id}/manifest")">Signed manifest</a>}@if(data.CanManage){@if(release.Status=="Quarantined"){<button class="button primary" disabled="@Model.Busy" @onclick="()=>Model.PublishAsync(release.Id)">Scan &amp; publish</button>}@if(release.Status!="Revoked"){<button class="button secondary" disabled="@Model.Busy" @onclick="()=>Model.RevokeAsync(release.Id)">Revoke</button>}}</div></li>}</ul></section>
}
@code {
 private ProductReleasesViewModel Model=null!;private IBrowserFile? File;private string Filename=>File?.Name??"No file selected.";
 protected override async Task OnInitializedAsync(){Model=new(Releases,Workspace);await Model.LoadAsync();}
 private void ChooseFile(InputFileChangeEventArgs e)=>File=e.File;
 private async Task Upload(){if(File is not null){await using var stream=File.OpenReadStream(512L*1024*1024);await Model.UploadAsync(File.Name,stream);File=null;}}
}
