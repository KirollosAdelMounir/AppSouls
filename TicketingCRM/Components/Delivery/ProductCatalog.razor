@using TicketingCRM.ViewModels
@using TicketingCRM.Domain.Workspace.DTOs
@inject TicketingCRM.Domain.Workspace.Interfaces.IWorkspaceService Service
@inject TicketingCRM.Domain.Identity.Interfaces.ICurrentActor Actor
<OperationFeedback Busy="Model.Busy" Message="@Model.Message" Error="Model.HasError" />
@if(Model.Data is {} data){<div class="support-layout"><section class="panel workspace-form"><h2>Software catalog</h2><RecordTable Items="data.Products" TItem="ProductDto"><Headings><th>Software</th><th>Product code</th></Headings><Row Context="item"><td>@item.Name</td><td>@item.Code · @item.LicenseExtension</td></Row></RecordTable><a href="/downloads">Manage installations and releases</a></section>
@if(Model.CanManage){<section class="panel workspace-form"><h2>Add software</h2><form @onsubmit="Model.CreateAsync" @onsubmit:preventDefault><fieldset class="form-fields" disabled="@(!Ready||Model.Busy)"><div class="soul-field"><label for="product-name">Name</label><input id="product-name" class="soul-input" @bind="Model.Name" required maxlength="160" /></div><div class="soul-field"><label for="product-code">Product code</label><input id="product-code" class="soul-input" @bind="Model.Code" required maxlength="64" /></div><div class="soul-field"><label for="product-extension">License extension</label><input id="product-extension" class="soul-input" @bind="Model.Extension" required maxlength="24" /></div><button class="button primary" type="submit">Add software</button></fieldset></form></section>}</div>}
@code {
 private ProductCatalogViewModel Model=null!;private bool Ready;
 protected override async Task OnInitializedAsync(){Model=new(Service,Actor);await Model.LoadAsync();}
 protected override void OnAfterRender(bool firstRender){if(firstRender){Ready=true;StateHasChanged();}}
}
