@using TicketingCRM.ViewModels
@using TicketingCRM.Domain.Workspace.DTOs
@inject TicketingCRM.Domain.Workspace.Interfaces.IWorkspaceService Service
@inject TicketingCRM.Domain.Identity.Interfaces.ICurrentActor Actor
<OperationFeedback Busy="Model.Busy" Message="@Model.Message" Error="Model.HasError" />
@if(Model.Data is {} data){<div class="support-layout"><section class="panel workspace-form"><h2>Contracts</h2><RecordTable Items="data.Contracts" TItem="ContractDto"><Headings><th>Reference</th><th>Status</th></Headings><Row Context="item"><td>@item.Reference</td><td>@item.Status @if(Model.CanManage&&item.Status=="Draft"){<button class="button secondary" disabled="@Model.Busy" @onclick="()=>Model.ActivateAsync(item.Id)">Activate</button>}</td></Row></RecordTable></section>
@if(Model.CanManage){<section class="panel workspace-form"><h2>Create contract</h2><form @onsubmit="Model.CreateAsync" @onsubmit:preventDefault><fieldset class="form-fields" disabled="@(!Ready||Model.Busy)"><SoulDropdown Label="Customer" Options="Model.Customers" @bind-Value="Model.Customer" /><div class="soul-field"><label for="contract-reference">Reference</label><input id="contract-reference" class="soul-input" @bind="Model.Reference" required maxlength="100" /></div><SoulDateTimePicker Label="Starts at UTC" UseUtc="true" @bind-Value="Model.Starts" /><SoulDateTimePicker Label="Ends at UTC" UseUtc="true" @bind-Value="Model.Ends" /><button class="button primary" type="submit">Create contract</button></fieldset></form></section>}</div>
@if(Model.CanManage){<section class="panel workspace-form"><h2>Grant purchased software</h2><form @onsubmit="Model.GrantAsync" @onsubmit:preventDefault><fieldset class="form-fields" disabled="@(!Ready||Model.Busy)"><div class="form-grid"><SoulDropdown Label="Active contract" Options="Model.Contracts" @bind-Value="Model.Contract" /><SoulDropdown Label="Software" Options="Model.Products" @bind-Value="Model.Product" /><div class="soul-field"><label for="contract-capacity">Installation limit</label><input id="contract-capacity" class="soul-input" type="number" min="1" max="100000" @bind="Model.Capacity" /></div><SoulDateTimePicker Label="Expires at UTC" UseUtc="true" @bind-Value="Model.Expires" /></div><button class="button primary" type="submit">Grant entitlement</button></fieldset></form></section>}}
@code {
 private ContractsViewModel Model=null!;private bool Ready;
 protected override async Task OnInitializedAsync(){Model=new(Service,Actor);await Model.LoadAsync();}
 protected override void OnAfterRender(bool firstRender){if(firstRender){Ready=true;StateHasChanged();}}
}
