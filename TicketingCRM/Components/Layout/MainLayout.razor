@inherits LayoutComponentBase
@inject NavigationManager Navigation
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="workspace">
    <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-mark">A</span><span>App Souls<small>by Tetrarchia</small></span></a>
        <div class="workspace-label">WORKSPACE</div>
        <NavMenu />
        <div class="sidebar-bottom"><span class="status-dot"></span> Workspace connected<small>Your CRM and licensing workspace</small></div>
    </aside>
    <div class="workspace-body">
        <header class="topbar"><span class="breadcrumb">Workspace <span>/</span> @SectionTitle</span><div class="topbar-actions"><div class="appearance-control"><SoulDropdown Id="theme-choice" Label="Appearance" ClientTheme="true" Options="ThemeOptions" /></div><ProfileMenu /></div></header>
        <AuthorizeView><ChatAlerts @rendermode="InteractiveServer" /></AuthorizeView>
        <main id="main-content" tabindex="-1" class="@(Navigation.ToBaseRelativePath(Navigation.Uri).Split('/')[0] == "settings" ? "settings-main" : "")"><div class="view-content">@Body</div></main>
        <footer>App Souls <span>CRM &amp; Licensing by Tetrarchia</span></footer>
    </div>
</div>
<div id="blazor-error-ui" role="alert">The connection encountered an error. <a href=".">Reload workspace</a></div>

@code { private static readonly string[] ThemeOptions = ["Light", "Dark", "System"]; private string SectionTitle => Navigation.ToBaseRelativePath(Navigation.Uri).Split('/')[0] switch { "customers" => "Customers", "sales" => "Sales pipeline", "leads" => "Leads", "opportunities" => "Opportunities", "orders" => "Orders", "invoices" => "Invoices", "contracts" => "Orders & contracts", "products" => "Software catalog", "downloads" => "Software downloads", "license-models" => "License models", "licenses" => "Licenses", "installations" => "Installations", "support" => "Support", "settings" => "System settings", "users" => "Users & access", _ => "Overview" }; }
