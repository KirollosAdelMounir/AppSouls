@using TicketingCRM.ViewModels
@inject TicketingCRM.Domain.Customers.Interfaces.ICustomerLifecycleService Service
<OperationFeedback Busy="Model.Busy" Message="@Model.Message" Error="Model.HasError" />
@if(Model.Data is {} data){
<div class="page-heading"><div><p class="eyebrow">CUSTOMER RELATIONSHIP</p><h1>@data.Customer.Name</h1><p>@data.Customer.Email · @data.Customer.CompanyNumber</p></div><a class="button secondary" href="/customers">All customers</a></div>
<div class="customer-summary"><section class="panel workspace-form"><h2>Sales and subscriptions</h2><p>@if(data.CanManage){<span>@data.Opportunities.Count opportunities · </span>}@data.Contracts.Count contracts · @data.Subscriptions.Count subscriptions</p>@if(data.CanManage){<a class="button secondary" href="/sales">Manage sales pipeline</a>} <a class="button secondary" href="/contracts">Manage contracts and purchases</a></section><section class="panel workspace-form"><h2>Technical support</h2><p>@data.Support.Count reports</p><ul>@foreach(var ticket in data.Support){<li @key="ticket.Id"><a href="@($"/support/{ticket.Id}")">@ticket.Reference · @ticket.Title</a> · @ticket.Stage</li>}</ul><a href="/support">Support workspace</a></section></div>
@if(data.CanManage){<section class="panel workspace-form"><h2>Customer account onboarding</h2>@if(data.Invitations.Count==0){<p>Choose a won opportunity and an active contract with purchased software. The customer chooses their own password through an expiring email link.</p><div class="form-grid"><SoulDropdown Label="Won opportunity" Options="Model.Opportunities" @bind-Value="Model.Opportunity" /><SoulDropdown Label="Active contract" Options="Model.Contracts" @bind-Value="Model.Contract" /></div><button class="button primary" @onclick="Model.FinalizeAsync" disabled="@Model.Busy">Finalize &amp; queue account invitation</button>}<ul>@foreach(var invite in data.Invitations){<li @key="invite.Id">@(invite.Accepted?"Account activated":"Invitation prepared") · expires @invite.ExpiresAtUtc.ToString("u") @if(!invite.Accepted){<button class="button secondary" disabled="@Model.Busy" @onclick="()=>Model.ReissueAsync(invite.Id)">Reissue password-setup invitation</button>}</li>}</ul></section>}
@if(data.CanManage||Technical){<section class="panel workspace-form"><h2>Record a sales or technical activity</h2><div class="form-grid"><SoulDropdown Label="Activity type" Options="ActivityKinds" @bind-Value="Model.Kind" /><div class="soul-field"><label for="activity-subject">Subject</label><input id="activity-subject" class="soul-input" @bind="Model.Subject" maxlength="200" /></div><SoulDateTimePicker Label="Follow-up at UTC" UseUtc="true" @bind-Value="Model.FollowUp" /><div class="soul-field"><label for="activity-notes">Internal notes</label><textarea id="activity-notes" class="soul-input" @bind="Model.Notes" maxlength="4000"></textarea></div></div><button class="button primary" @onclick="Model.RecordAsync" disabled="@Model.Busy">Record activity</button></section><section class="panel workspace-form"><h2>Activity timeline</h2><ol>@foreach(var activity in data.Activities){<li @key="activity.Id"><strong>@activity.Kind · @activity.Subject</strong><p>@activity.Notes</p><time>@activity.OccurredAtUtc.ToString("u")</time>@if(activity.FollowUpAtUtc is {} due){<p>Follow-up: @due.ToString("u")</p>}</li>}</ol></section>}
}
else if(!Model.Busy){<p>The customer is unavailable for this membership.</p>}
@code {
 [Parameter]public Guid CustomerId{get;set;}
 [Inject]public TicketingCRM.Domain.Identity.Interfaces.ICurrentActor Actor{get;set;}=default!;
 private CustomerLifecycleViewModel Model=null!;private bool Technical=>Actor.Role=="Technical";private IReadOnlyList<string> ActivityKinds=>Technical?["Note","Technical"]:CustomerLifecycleViewModel.Kinds;
 protected override async Task OnParametersSetAsync(){Model=new(Service,CustomerId);await Model.LoadAsync();}
}
