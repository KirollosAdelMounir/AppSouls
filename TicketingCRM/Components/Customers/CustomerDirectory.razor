@using TicketingCRM.ViewModels
@using TicketingCRM.Domain.Workspace.DTOs
@inject TicketingCRM.Domain.Workspace.Interfaces.IWorkspaceService Service
@inject TicketingCRM.Domain.Identity.Interfaces.ICurrentActor Actor
<OperationFeedback Busy="Model.Busy" Message="@Model.Message" Error="Model.HasError" />
@if(Model.Data is {} data){<div class="workflow-stack page-enter">@if(Mode != "new"){<section class="panel workspace-form"><h2>Customers</h2><p>Open a relationship to manage its sales, subscriptions, activities and support.</p><RecordTable Items="data.Customers" TItem="CustomerDto"><Headings><th>Customer</th><th>Contact email</th></Headings><Row Context="item"><td><a href="@($"/customers/{item.Id}")">@item.Name</a></td><td>@item.Email</td></Row></RecordTable>@if(Model.CanManage){<a class="button primary" href="/customers/new">Add customer</a>}</section>}
@if(Mode == "new" && Model.CanManage){<section class="panel workspace-form"><h2>Add a customer</h2><form @onsubmit="Model.CreateAsync" @onsubmit:preventDefault><fieldset class="form-fields" disabled="@(!Ready||Model.Busy)"><div class="soul-field"><label for="customer-name">Customer name</label><input id="customer-name" class="soul-input" @bind="Model.Name" required maxlength="160" /></div><div class="soul-field"><label for="customer-email">Contact email</label><input id="customer-email" class="soul-input" type="email" @bind="Model.Email" required maxlength="254" /></div><div class="soul-field"><label for="customer-company">Company number</label><input id="customer-company" class="soul-input" @bind="Model.CompanyNumber" maxlength="100" /></div><button class="button primary" type="submit">Create customer</button></fieldset></form><p><a href="/leads/new">Start with a lead instead</a></p></section>}</div>}
@code {
 [Parameter] public string Mode {get;set;} = "list";
 private CustomerDirectoryViewModel Model=null!;private bool Ready;
 protected override async Task OnInitializedAsync(){Model=new(Service,Actor);await Model.LoadAsync();}
 protected override void OnAfterRender(bool firstRender){if(firstRender){Ready=true;StateHasChanged();}}
}
