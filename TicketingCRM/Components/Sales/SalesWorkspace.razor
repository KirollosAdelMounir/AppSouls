@using System.Globalization
@using TicketingCRM.ViewModels
@using TicketingCRM.Domain.Sales.Models
@inject TicketingCRM.Domain.Sales.Interfaces.ISalesPipelineService Service
@inject TicketingCRM.Domain.Workspace.Interfaces.IWorkspaceService Workspace
@inject TicketingCRM.Domain.Identity.Interfaces.ICurrentActor Actor
@inject NavigationManager Navigation
<div class="page-enter workflow-stack">
@if(Model.Loading){<p role="status">Loading sales records…</p>}
else if(!Model.Allowed){<section class="panel workspace-form"><h2>Sales workspace unavailable</h2><p>@Model.Error</p></section>}
else
{
 @if(Model.Error is not null){<p class="feedback" role="alert">@Model.Error</p>}
 @if(Model.Message is not null){<p class="feedback" role="status">@Model.Message</p>}
 @if(Mode == "list" && Model.Data is {} data)
 {
  <section class="panel workspace-form"><div class="panel-heading"><h2>@(Opportunity ? "Opportunities" : "Leads")</h2><span>@(Opportunity ? data.OpportunityCount : data.LeadCount) records</span></div>
  @if(Opportunity)
  {
   @foreach(var item in data.Opportunities){<article class="sales-record" @key="item.Id"><div class="record-heading"><div><h3><a href="@($"{Prefix}/{item.Id}")">@item.Title</a></h3><p>@item.CustomerName · @item.Stage</p><p>@item.Currency @item.ExpectedValue.ToString("N2", CultureInfo.InvariantCulture)</p></div><a class="button secondary" href="@($"{Prefix}/{item.Id}")">Open opportunity</a></div></article>}
   @if(data.Opportunities.Count == 0){<p>No opportunities on this page.</p>}
  }
  else
  {
   @foreach(var item in data.Leads){<article class="sales-record" @key="item.Id"><div class="record-heading"><div><h3><a href="@($"{Prefix}/{item.Id}")">@item.CompanyName</a></h3><p>@item.ContactName · @item.Email</p><span class="sales-stage">@item.Stage</span></div><a class="button secondary" href="@($"{Prefix}/{item.Id}")">Open lead</a></div></article>}
   @if(data.Leads.Count == 0){<p>No leads on this page.</p>}
  }
  <div class="sales-pagination"><button class="button secondary" disabled="@(Model.Busy || Model.Page == 1)" @onclick="() => Model.NavigateAsync(-1)">Previous</button><span>Page @Model.Page</span><button class="button secondary" disabled="@(Model.Busy || !Model.More)" @onclick="() => Model.NavigateAsync(1)">Next</button></div></section>
 }
 else if(Mode == "new")
 {
  @if(Opportunity){<SalesOpportunityForm Model="Model" Disabled="@(!RendererInfo.IsInteractive || Model.Busy)" OnCreate="SaveOpportunity" OnCancel="Back" />}
  else{<SalesLeadForm Model="Model" Disabled="@(!RendererInfo.IsInteractive || Model.Busy)" OnCreate="SaveLead" />}
 }
 else
 {
  @if(Model.SelectedLead is {} lead){<div class="workflow-intro"><h2>@lead.CompanyName</h2><p>@lead.ContactName · @lead.Email · @lead.Stage</p></div>}
  @if(Model.SelectedOpportunity is {} opportunity){<div class="workflow-intro"><h2>@opportunity.Title</h2><p>@opportunity.CustomerName · @opportunity.Stage</p></div>}
  @if(Mode == "activity"){<SalesActivityEditor Model="Model" Disabled="@(!RendererInfo.IsInteractive || Model.Busy)" OnSave="SaveActivity" OnCancel="Back" />}
  else if(Mode == "stage"){<SalesStageEditor Model="Model" Disabled="@(!RendererInfo.IsInteractive || Model.Busy)" OnSave="SaveStage" OnCancel="Back" />}
  else if(Mode == "convert"){<SalesOpportunityForm Model="Model" Disabled="@(!RendererInfo.IsInteractive || Model.Busy)" OnCreate="SaveOpportunity" OnCancel="Back" />}
  else if(Mode == "history")
  {
   <section class="panel workspace-form"><div class="workflow-toolbar"><a class="button secondary" href="@ReturnPath">Record details</a><a class="button primary" href="@(ReturnPath + "/activity")">Record activity</a></div><h2>History</h2><p>Latest 50 events · UTC</p><ol class="sales-history">@foreach(var item in Model.History ?? []){<li @key="item.Id"><strong>@(string.IsNullOrEmpty(item.FromStage) ? "Created" : item.FromStage) → @item.ToStage</strong><p>@item.Reason</p><time>@item.OccurredAtUtc.ToString("u")</time></li>}</ol>@if(Model.History?.Count == 0){<p>No events yet.</p>}</section>
  }
  else if(Mode == "detail")
  {
   <section class="panel workspace-form"><div class="workflow-toolbar"><a class="button primary" href="@(ReturnPath + "/activity")">Record activity</a><a class="button secondary" href="@(ReturnPath + "/history")">History</a><a class="button secondary" href="@(ReturnPath + "/stage")">Change stage</a>@if(Model.SelectedLead?.Stage == LeadStage.Qualified){<a class="button primary" href="@(ReturnPath + "/convert")">Convert lead</a>}</div>
   @if(Model.SelectedLead is {} l){<dl class="record-details"><dt>Contact</dt><dd>@l.ContactName</dd><dt>Phone</dt><dd>@l.Phone</dd><dt>Source</dt><dd>@l.Source</dd><dt>Owner</dt><dd>@Model.OwnerLabel(l.OwnerUserId)</dd><dt>Follow-up</dt><dd>@l.FollowUpAtUtc?.ToString("u")</dd><dt>Notes</dt><dd>@l.Notes</dd></dl>}
   @if(Model.SelectedOpportunity is {} o){<dl class="record-details"><dt>Customer</dt><dd><a href="/customers/@o.CustomerId">@o.CustomerName</a></dd><dt>Expected value</dt><dd>@o.Currency @o.ExpectedValue.ToString("N2", CultureInfo.InvariantCulture)</dd><dt>Owner</dt><dd>@Model.OwnerLabel(o.OwnerUserId)</dd><dt>Follow-up</dt><dd>@o.FollowUpAtUtc?.ToString("u")</dd></dl>}
   </section>
  }
 }
}
</div>
@code {
 [Parameter] public bool Opportunity { get; set; }
 [Parameter] public string Mode { get; set; } = "list";
 [Parameter] public Guid? RecordId { get; set; }
 private SalesPipelineViewModel Model = default!;
 private string Prefix => Opportunity ? "/opportunities" : "/leads";
 private string ReturnPath => RecordId is {} id ? $"{Prefix}/{id}" : Prefix;
 protected override async Task OnParametersSetAsync(){Model = new(Service,Workspace,Actor);await Model.InitializeViewAsync(Opportunity,Mode,RecordId);}
 private void Back() => Navigation.NavigateTo(ReturnPath);
 private async Task SaveActivity(){await Model.SaveActivityAsync();if(Model.Error is null)Back();}
 private async Task SaveStage(){await Model.SaveStageAsync();if(Model.Error is null)Back();}
 private async Task SaveLead(){await Model.CreateLeadAsync();if(Model.Error is null)Navigation.NavigateTo("/leads");}
 private async Task SaveOpportunity(){await Model.CreateOpportunityAsync();if(Model.Error is null)Navigation.NavigateTo("/opportunities");}
}
