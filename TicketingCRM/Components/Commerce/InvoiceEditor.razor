@using TicketingCRM.ViewModels
<section class="panel workspace-form page-enter"><h2>@Model.TargetLabel · invoice entry</h2><p>Sales Managers enter the complete pricing, tax percentages and billing details. Issued invoices are preserved as immutable records.</p><form @onsubmit="OnSave" @onsubmit:preventDefault><fieldset class="form-fields" disabled="@(Model.Busy||!Model.CanInvoice||string.IsNullOrEmpty(Model.TargetLabel)||!RendererInfo.IsInteractive)">
 <div class="form-grid"><div class="soul-field"><label for="invoice-number">Invoice number</label><input id="invoice-number" class="soul-input" @bind="Model.Reference" required maxlength="100" /></div><SoulDropdown Label="Currency" Options="CommerceViewModel.Currencies" @bind-Value="Model.Currency" /><SoulDateTimePicker Label="Invoice date (UTC)" UseUtc="true" @bind-Value="Model.IssueDate" /><SoulDateTimePicker Label="Due date (UTC, optional)" UseUtc="true" @bind-Value="Model.DueDate" /></div>
 <div class="workflow-details"><section><h3>Supplier</h3><div class="soul-field"><label for="supplier-name">Supplier legal name</label><input id="supplier-name" class="soul-input" @bind="Model.SupplierName" required maxlength="200" /></div><div class="soul-field"><label for="supplier-tax">Supplier tax reference</label><input id="supplier-tax" class="soul-input" @bind="Model.SupplierTaxId" maxlength="100" /></div><div class="soul-field"><label for="supplier-address">Supplier address</label><textarea id="supplier-address" class="soul-input" @bind="Model.SupplierAddress" required maxlength="2000"></textarea></div></section><section><h3>Customer</h3><div class="soul-field"><label for="buyer-name">Buyer legal name</label><input id="buyer-name" class="soul-input" @bind="Model.BuyerName" required maxlength="200" /></div><div class="soul-field"><label for="buyer-tax">Buyer tax reference</label><input id="buyer-tax" class="soul-input" @bind="Model.BuyerTaxId" maxlength="100" /></div><div class="soul-field"><label for="buyer-address">Buyer address</label><textarea id="buyer-address" class="soul-input" @bind="Model.BuyerAddress" required maxlength="2000"></textarea></div></section></div>
 <h3>Items and pricing</h3><CommercialLinesEditor Model="Model" />
 <div class="soul-field"><label for="invoice-payment">Payment terms</label><textarea id="invoice-payment" class="soul-input" @bind="Model.PaymentTerms" maxlength="2000"></textarea></div><div class="soul-field"><label for="invoice-notes">Invoice notes</label><textarea id="invoice-notes" class="soul-input" @bind="Model.Notes" maxlength="4000"></textarea></div><button type="submit" class="button primary">Generate invoice</button><p class="availability">PDF invoice only. No tax-authority submission or payment collection is performed.</p>
</fieldset></form></section>
@code{[Parameter,EditorRequired]public CommerceViewModel Model{get;set;}=default!;[Parameter]public EventCallback OnSave{get;set;}}
