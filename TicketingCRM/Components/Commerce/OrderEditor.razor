@using TicketingCRM.ViewModels
<section class="panel workspace-form page-enter"><h2>Order details</h2><p>This records the commercial agreement; it does not claim a payment was received.</p><form @onsubmit="OnSave" @onsubmit:preventDefault><fieldset class="form-fields" disabled="@(Model.Busy||!RendererInfo.IsInteractive)"><div class="form-grid"><SoulDropdown Label="Customer" Options="Model.CustomerOptions" @bind-Value="Model.Customer" /><div class="soul-field"><label for="order-reference">Order reference</label><input id="order-reference" class="soul-input" @bind="Model.Reference" required maxlength="100" /></div><SoulDropdown Label="Currency" Options="CommerceViewModel.Currencies" @bind-Value="Model.Currency" /></div><CommercialLinesEditor Model="Model" /><div class="soul-field"><label for="order-notes">Order notes</label><textarea id="order-notes" class="soul-input" @bind="Model.Notes" maxlength="4000"></textarea></div><button type="submit" class="button primary">Record order</button></fieldset></form></section>
@code{[Parameter,EditorRequired]public CommerceViewModel Model{get;set;}=default!;[Parameter]public EventCallback OnSave{get;set;}}
