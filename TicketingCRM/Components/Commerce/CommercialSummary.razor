@using TicketingCRM.Domain.Commerce.DTOs
<div class="table-scroll" role="region" aria-label="Commercial line items" tabindex="0"><table class="data-table"><thead><tr><th scope="col">Description</th><th scope="col">Quantity</th><th scope="col">Unit price</th><th scope="col">Discount</th><th scope="col">Tax</th><th scope="col">Total</th></tr></thead><tbody>@foreach(var line in Lines){<tr><td>@line.Description</td><td>@line.Quantity</td><td>@line.UnitPrice.ToString("N2")</td><td>@line.Discount.ToString("N2") (@line.DiscountPercent%)</td><td>@line.Tax.ToString("N2") (@line.TaxPercent%)</td><td>@line.Total.ToString("N2")</td></tr>}</tbody></table></div>
<dl class="record-details"><dt>Subtotal</dt><dd>@Currency @Totals.Subtotal.ToString("N2")</dd><dt>Discount</dt><dd>@Currency @Totals.Discount.ToString("N2")</dd><dt>Tax</dt><dd>@Currency @Totals.Tax.ToString("N2")</dd><dt>Total</dt><dd><strong>@Currency @Totals.Total.ToString("N2")</strong></dd></dl>
@code{[Parameter]public IReadOnlyList<PricedLine> Lines{get;set;}=[];[Parameter,EditorRequired]public CommercialTotals Totals{get;set;}=default!;[Parameter]public string Currency{get;set;}="USD";}
